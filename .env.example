# ===================================================
# ColorTag Environment Configuration
# ===================================================

# Private key for deploying the contract to Botchain Testnet (DO NOT SHARE OR COMMIT)
# Example: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY="your_private_key_here"

# Botchain Testnet RPC URL (default: https://rpc.bohr.life)
BOTCHAIN_RPC_URL="https://rpc.bohr.life"

# Contract address once deployed on Botchain Testnet
# Used by the frontend dApp
NEXT_PUBLIC_COLORTAG_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
